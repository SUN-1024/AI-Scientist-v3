# Patch only task-runner command-line dependencies, preserving the built image.
ARG BASE_IMAGE=agentic-scientist/agent-cli:latest
FROM ${BASE_IMAGE}
USER root
ARG DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
ARG DEBIAN_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security
RUN set -eux; \
    . /etc/os-release; \
    rm -f /etc/apt/sources.list; \
    find /etc/apt/sources.list.d -type f \( -name '*.list' -o -name '*.sources' \) -delete; \
    printf 'deb %s %s main\ndeb %s %s-updates main\ndeb %s %s-security main\n' \
      "$DEBIAN_MIRROR" "$VERSION_CODENAME" \
      "$DEBIAN_MIRROR" "$VERSION_CODENAME" \
      "$DEBIAN_SECURITY_MIRROR" "$VERSION_CODENAME" > /etc/apt/sources.list; \
    apt-get update -o Acquire::ForceIPv4=true -o Acquire::Retries=2 -o Acquire::https::Timeout=30; \
    apt-get install -y --no-install-recommends ripgrep time bc; \
    rm -rf /var/lib/apt/lists/*
USER agent
RUN rg --version && /usr/bin/time --version && test "$(echo '2+2' | bc)" = 4
